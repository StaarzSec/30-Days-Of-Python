def calculate_slope(x1 : float, y1 : float, x2 : float, y2 : float) ->float:
    slope = (y2-y1) / (x2-x1)
    return slope

# 7 :
def solve_quadratic_eqn(a : float, b : float, c : float, x : float) -> float:
    result = a * x**2 + b * x + c
    return result

