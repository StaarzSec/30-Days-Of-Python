# 14 :
def sum_of_odds(num: int) -> int:
    sum = 0
    for i in range(1, num + 1):
        if i % 2 != 0:
            sum += i
    return sum

# 15 : 
def sum_of_evens(num: int) -> int:
    sum = 0
    for i in range(1, num + 1):
        if i % 2 == 0:
            sum += i
    return sum

