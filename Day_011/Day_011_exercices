# 1 :
def evens_and_odds(num: int) -> tuple:
    even = 0
    odd = 0
    for i in range(1, num + 1):
        if i % 2 == 0:
            even += 1
        else:
            odd += 1
    return f"The number of odds are {odd}\nThe number of evens are {even}."
print(evens_and_odds(100))

# 2 :
def factorial(num: int) -> int:
    if num == 0 or num == 1:
        return 1
    else:
        return num * factorial(num - 1)
    
